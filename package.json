{
  "name": "@root/cordis",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "external/*",
    "packages/*",
    "packages/fs/*",
    "packages/server/*"
  ],
  "license": "MIT",
  "scripts": {
    "lint": "oxlint",
    "yakumo": "node --expose-internals --import tsx --import @cordisjs/unyaml node_modules/yakumo/lib/cli.js",
    "postinstall": "yarn yakumo postinstall",
    "build": "yarn yakumo esbuild && yarn yakumo tsc",
    "test": "yarn yakumo vitest --import tsx",
    "test:text": "shx rm -rf coverage && yarn test --coverage --coverage.reporter text",
    "test:json": "shx rm -rf coverage && yarn test --coverage --coverage.reporter json",
    "test:html": "shx rm -rf coverage && yarn test --coverage --coverage.reporter html"
  },
  "devDependencies": {
    "@cordisjs/unyaml": "^3.0.0",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "oxlint": "^1.93.0",
    "semver": "^7.8.6",
    "shx": "^0.4.0",
    "tsx": "npm:@cordisjs/tsx@4.23.15-fix.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5",
    "yakumo": "patch:yakumo@npm%3A3.4.2#~/.yarn/patches/yakumo-npm-3.4.2-e527abe6ed.patch",
    "yakumo-esbuild": "patch:yakumo-esbuild@npm%3A3.1.1#~/.yarn/patches/yakumo-esbuild-npm-3.1.1-9f5f8f52da.patch",
    "yakumo-tsc": "patch:yakumo-tsc@npm%3A3.1.1#~/.yarn/patches/yakumo-tsc-npm-3.1.1-4ed307d193.patch",
    "yakumo-vitest": "patch:yakumo-vitest@npm%3A1.4.1#~/.yarn/patches/yakumo-vitest-npm-1.4.1-e09ff4a335.patch"
  }
}
