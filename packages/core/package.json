  "license": "MIT",
  "peerDependencies": {
    "@cordisjs/fs": "^2.0.0-rc.0",
    "@cordisjs/fs-node": "^0.1.0",
    "@cordisjs/include": "^2.0.0-rc.0",
    "@cordisjs/loader": "^1.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@cordisjs/fs": {
      "optional": true
